{
  "compilerOptions": {
    "outDir": "./build/backend",
    "rootDir": "./src/backend",

    "module": "ESNext",
    "target": "ES2020",
    "moduleResolution": "node",

    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,

    "noEmit": false,
    "skipLibCheck": true
  },
  "include": ["src/backend/**/*.ts"]
}
